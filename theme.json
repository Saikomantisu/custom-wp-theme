{
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        },
        "color": {
            "custom": false,
            "customGradient": false,
            "palette": [
                {
                    "slug": "primary",
                    "color": "#111827",
                    "name": "Dark Text"
                },
                {
                    "slug": "background",
                    "color": "#f9fafb",
                    "name": "Light Background"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "dropCap": false,
            "fontFamilies": [
                {
                    "slug": "mono",
                    "fontFamily": "SFMono-Regular, Consolas, \"Liberation Mono\", Menlo, monospace",
                    "name": "Mono"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "base",
                    "size": "1rem",
                    "name": "Normal"
                },
                {
                    "slug": "large",
                    "size": "1.5rem",
                    "name": "Large"
                },
                {
                    "slug": "huge",
                    "size": "2.25rem",
                    "name": "Huge"
                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        }
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--mono)",
            "fontSize": "var(--wp--preset--font-size--base)",
            "lineHeight": "1.6"
        },
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--primary)"
        }
    }
}